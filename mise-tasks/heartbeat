#!/usr/bin/env bash
#MISE description="Step 5: send one heartbeat (POST, no body) to maintain the lease"
#USAGE arg "<work_id>"
#USAGE arg "[expected_last_heartbeat]" default="NO_HEARTBEAT"
#USAGE arg "[desired_ttl_seconds]"
# docs: https://platform.claude.com/docs/en/api/beta/environments/work#heartbeat
# - first call: pass "NO_HEARTBEAT" (default) to claim an unclaimed lease.
# - subsequent calls: pass the previous response's last_heartbeat verbatim.
# - mismatched expected_last_heartbeat -> 412 Precondition Failed.
set -euo pipefail

work_id="${usage_work_id:-${1:?work id required}}"
expected="${usage_expected_last_heartbeat:-${2:-NO_HEARTBEAT}}"
ttl="${usage_desired_ttl_seconds:-${3:-}}"

qs="expected_last_heartbeat=$expected"
[[ -n "$ttl" ]] && qs="$qs&desired_ttl_seconds=$ttl"

set -x
curl -sS -X POST "https://api.anthropic.com/v1/environments/$ENV_ID/work/$work_id/heartbeat?$qs" \
  -H "Authorization: Bearer $ENV_KEY" \
  -H "anthropic-version: 2023-06-01" \
  -H "anthropic-beta: $ANTHROPIC_BETA" \
  | jq
