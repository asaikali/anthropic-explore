#!/usr/bin/env bash
#MISE description="Step 3b: ack a work item (queued -> starting). Required after poll."
#USAGE arg "<work_id>"
# docs: https://platform.claude.com/docs/en/api/beta/environments/work#ack
set -euo pipefail

work_id="${usage_work_id:-${1:?work id required}}"

set -x
curl -sS -X POST "https://api.anthropic.com/v1/environments/$ENV_ID/work/$work_id/ack" \
  -H "Authorization: Bearer $ENV_KEY" \
  -H "anthropic-version: 2023-06-01" \
  -H "anthropic-beta: $ANTHROPIC_BETA" \
  | jq
