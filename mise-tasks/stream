#!/usr/bin/env bash
#MISE description="Experimental: try SSE stream of session events (Accept: text/event-stream)"
#USAGE arg "<session_id>"
# NOTE: the public API reference for session events documents only
#   GET  /v1/sessions/{id}/events  (paginated JSON list)
#   POST /v1/sessions/{id}/events  (send events)
# There is no documented `/events/stream` path. This task tries the GET
# endpoint with `Accept: text/event-stream` in case the server upgrades
# to SSE. If you only get a single JSON response, streaming isn't
# supported on this endpoint — use `mise run events` and poll instead.
set -euo pipefail

session_id="${usage_session_id:-${1:?session id required}}"

set -x
curl -N -sS "https://api.anthropic.com/v1/sessions/$session_id/events" \
  -H "x-api-key: $ENV_KEY" \
  -H "anthropic-version: 2023-06-01" \
  -H "anthropic-beta: $ANTHROPIC_BETA" \
  -H "Accept: text/event-stream"
