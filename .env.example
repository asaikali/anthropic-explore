co# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Loaded automatically by mise via `_.file = ".env"` in mise.toml.

# OAuth access token from the Anthropic Console (Managed Agents)
ENV_KEY=sk-ant-oat01-...

# The self-hosted environment id you created
ENV_ID=env_...

# Your org API key, used for ops/admin calls
API_KEY=sk-ant-api03-...
